# ETF-Allocator 本地敏感配置
#
# 用法：
#   1. 复制本文件为 .env  （`copy .env.example .env`）
#   2. 填入真实 token
#   3. .env 已被根 .gitignore 忽略，不会进版本库
#
# 优先级：进程环境变量 > .env
# （即 `set TUSHARE_TOKEN=xxx` 临时设置的值仍优先于 .env）

# Tushare Pro token —— 到 https://tushare.pro 个人主页获取
# 用于 scripts/import_pb*.py / auto_import_pb.py 拉取行业指数 PE/PB
TUSHARE_TOKEN=your_tushare_token_here
